# ==============================================================================
# ImageKit Credentials (https://imagekit.io)
# ==============================================================================
# Public key found in ImageKit Dashboard -> Developer Options -> API Keys
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here

# Private key (KEEP SECRET! NEVER prefix with NEXT_PUBLIC_ or expose to client)
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here

# Your ImageKit URL endpoint (e.g. https://ik.imagekit.io/your_id)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Target folder inside ImageKit for uploads
IMAGEKIT_DEFAULT_FOLDER=/the-digital-pillar

# ==============================================================================
# Google Drive API Authorization (For Local Migration CLI)
# ==============================================================================
# Option 1: Google Cloud Service Account (RECOMMENDED - Effortless & Secure)
# Path to downloaded service account JSON file from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./google-service-account.json

# Option 2: Google OAuth2 (Alternative if not using Service Account)
# GOOGLE_CLIENT_ID=your_oauth_client_id
# GOOGLE_CLIENT_SECRET=your_oauth_client_secret
# GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token

